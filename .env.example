# ----- Server -----
PORT=5000
# Comma separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5500,https://yourusername.github.io

# ----- Admin login (this is YOU, the only admin) -----
ADMIN_USERNAME=admin
# Generate a bcrypt hash for your password — see README section "Create your admin password"
ADMIN_PASSWORD_HASH=paste_bcrypt_hash_here
# Any long random string, used to sign login tokens
JWT_SECRET=replace_with_a_long_random_string

# ----- Google Drive (file storage) -----
# The Google Drive folder ID where all PDFs will be stored (create a folder in Drive and copy the ID from its URL)
GDRIVE_ROOT_FOLDER_ID=paste_drive_folder_id_here
# Paste the full contents of the service-account JSON key file (see README) as ONE line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ----- Firebase (database for categories & note metadata) -----
# Paste the full contents of the Firebase service-account JSON key file as ONE line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
